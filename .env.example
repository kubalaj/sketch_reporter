# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Where you reach this app in a browser. Its host must match the
# "Authorization Callback Domain" on your Strava API application.
BASE_URL=http://localhost:8000

# When to pull from Strava (5-field cron, UTC). Default: Mondays 03:00.
SYNC_CRON=0 3 * * 1

# Starting rates. These only seed the database on first run;
# change them later with PATCH /api/settings.
DEFAULT_MPG=25
DEFAULT_GAS_PRICE=3.50
DEFAULT_WEAR_PER_MILE=0.10
DEFAULT_BIKE_COST=3300
DEFAULT_TITLE_MATCH=e-bike
